# 英文商城询价造数 - UAT 环境
# 1) 复制为 .env.en.uat 并填值
# 2) python scripts/create_inquiry.py --env uat --source internal --mall en --form en ...

# —— 英文商城 ——
# EPAK_PLATFORM_BASE_URL=https://platform.esbpack.cn
# EPAK_PLATFORM_AUTH_ORIGIN=https://auth.esbpack.cn
# —— 中文站（--operate-via cn 时创建/流转走此域名）——
# PLATFORM_BASE_URL=https://uat-platform.ysbpack.cn
# BASE_URL=https://uat-auth.ysbpack.cn
# AUTH_API_URL=https://uat-auth.ysbpack.cn/api/member/login
# CRM_INQUIRY_OPERATE_VIA=en
# EPAK_LOGIN_PHONE=
# EPAK_LOGIN_PASSWORD_ENCRYPTED=
# EPAK_INQUIRY_TECH_ACCOUNT=
# EPAK_INQUIRY_TECH_PASSWORD_ENCRYPTED=
# EPAK_INQUIRY_PURCHASER_ACCOUNT=
# EPAK_INQUIRY_PURCHASER_PASSWORD_ENCRYPTED=
# EPAK_INQUIRY_SUPPORT_ACCOUNT=
# EPAK_INQUIRY_SUPPORT_PASSWORD_ENCRYPTED=

# —— 供应商：中文站登录 + 线上报价平台（与英文 EPAK_* 不同）——
# CRM_INQUIRY_SUPPLIER_ACCOUNT=
# CRM_INQUIRY_SUPPLIER_PASSWORD_ENCRYPTED=
# CRM_INQUIRY_SUPPLIER_AUTH_ORIGIN=https://uat-auth.ysbpack.cn
# CRM_INQUIRY_SUPPLIER_AUTH_API_URL=https://uat-auth.ysbpack.cn/api/member/login
# CRM_INQUIRY_SUPPLIER_PLATFORM_BASE_URL=https://uat-platform.ysbpack.cn

# —— 主数据 ——
# CRM_INQUIRY_EN_BUYER_MEMBER_ID=309
# CRM_INQUIRY_EN_BUYER_MEMBER_NAME=英文测试客户
# CRM_INQUIRY_EN_BUYER_USER_ID=101355
# CRM_INQUIRY_EN_BUYER_USER_NAME=英文测试客户
# EPAK_INQUIRY_SUPPLIER_MEMBER_ID=1857
# EPAK_INQUIRY_SUPPLIER_MEMBER_NAME=昆明市官渡区澳尔滨化妆品店
# 说明：中文 UAT 操作英文询价时，线下报价走
#   https://uat-platform.ysbpack.cn/api/crm/customer/iqrOfflineQuote/save?sourceMallType=2
# 英文站直连则用 EPAK_PLATFORM_BASE_URL + /api/transaction/iqrOfflineQuote/platform/save
# CRM_INQUIRY_EN_CATEGORY_FULL_ID=
# CRM_INQUIRY_EN_RELATION_SKU_IDS=
