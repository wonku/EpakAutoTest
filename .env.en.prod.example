# 英文商城询价 — 生产环境（prod）全套造数配置模板
#
# ========== 两阶段用法 ==========
# 【现在 / 上线前】比对域名 + 接口可达 + 登录/主数据只读，不创建单：
#   Copy-Item .env.en.prod.example .env.en.prod
#   # 取消注释并填齐下方参数后：
#   python scripts/verify_prod_inquiry_env.py --env prod --operate-via both
#   python scripts/verify_prod_inquiry_env.py --env prod --dump-urls-only
#
# 【上线当晚】跑全套造数（会写生产数据，须显式放行）:
#   python scripts/create_inquiry.py --env prod --allow-prod-seed --source internal --mall en --form en --status 已完成
#   python scripts/create_inquiry.py --env prod --allow-prod-seed --operate-via cn --source internal --mall en --form en --status 待转单
#   python scripts/create_inquiry.py --env prod --allow-prod-seed --source internal --mall en --form en --subs-file testdata/crm/multi_subs_quote_options.json
#
# 域名请与运维确认；下列为常见现网占位。
# 数字类配置请「取消注释并填值」，不要留空（空串会导致 int() 解析失败）。
# 真实 .env.en.prod 已 gitignore。

# —— 英文站 ——
EPAK_PLATFORM_BASE_URL=https://platform.epakgroup.com
EPAK_PLATFORM_AUTH_ORIGIN=https://auth.epakgroup.com

# —— 中文站（--operate-via cn；列表/流转走 CRM + sourceMallType=2）——
PLATFORM_BASE_URL=https://platform.ysbpack.cn
BASE_URL=https://auth.ysbpack.cn
AUTH_API_URL=https://auth.ysbpack.cn/api/member/login

CRM_INQUIRY_OPERATE_VIA=en
CRM_INQUIRY_CREATE_SOURCE=internal
CRM_INQUIRY_MALL=en
CRM_INQUIRY_FORM=en
CRM_INQUIRY_TARGET_STATUS=已完成
CRM_INQUIRY_ASK_PRICE_TYPE=定制品
CRM_INQUIRY_EN_QUOTE_CHANNELS=both
CRM_INQUIRY_EN_FACTORY_ADOPT_SOURCE=auto

# —— 节点角色（全套流转）——
# EPAK_LOGIN_PHONE=13550147740
# EPAK_LOGIN_PASSWORD_ENCRYPTED=HcCnzfhJr4kFtev4QVJnGA==
# EPAK_INQUIRY_TECH_ACCOUNT=18862141672
# EPAK_INQUIRY_TECH_PASSWORD_ENCRYPTED=5u0UAz/eKMKjZZ+zeVbxQw==
# EPAK_INQUIRY_PURCHASER_ACCOUNT=15346087993
# EPAK_INQUIRY_PURCHASER_PASSWORD_ENCRYPTED=QYA3znjH9+0ski/+mT/izA==
# EPAK_INQUIRY_SUPPORT_ACCOUNT=19383838383
# EPAK_INQUIRY_SUPPORT_PASSWORD_ENCRYPTED=QYA3znjH9+0ski/+mT/izA==

# 中文站操作时 EPAK_* 登不上可覆盖：
# CRM_INQUIRY_TECH_ACCOUNT=
# CRM_INQUIRY_PURCHASER_ACCOUNT=
# CRM_INQUIRY_SUPPORT_ACCOUNT=

# —— 供应商 ——
# CRM_INQUIRY_SUPPLIER_ACCOUNT=13914037462
# CRM_INQUIRY_SUPPLIER_PASSWORD_ENCRYPTED=QYA3znjH9+0ski/+mT/izA==
CRM_INQUIRY_SUPPLIER_AUTH_ORIGIN=https://auth.ysbpack.cn
CRM_INQUIRY_SUPPLIER_AUTH_API_URL=https://auth.ysbpack.cn/api/member/login
CRM_INQUIRY_SUPPLIER_PLATFORM_BASE_URL=https://platform.ysbpack.cn
# EPAK_INQUIRY_SUPPLIER_MEMBER_ID=
# EPAK_INQUIRY_SUPPLIER_MEMBER_NAME=

# —— 买家 / 品类 / 关联商品 ——
# CRM_INQUIRY_EN_BUYER_MEMBER_ID=
# CRM_INQUIRY_EN_BUYER_MEMBER_NAME=
# CRM_INQUIRY_EN_BUYER_USER_ID=
# CRM_INQUIRY_EN_BUYER_USER_NAME=
# CRM_INQUIRY_EN_CATEGORY_FULL_ID=
# CRM_INQUIRY_EN_RELATION_SKU_IDS=

# —— 转单 / 订单 ——
CRM_INQUIRY_EN_ORDER_CURRENCY_ID=3
CRM_INQUIRY_EN_ORDER_TRADE_MODE=4
# CRM_INQUIRY_EN_ORDER_SHOP_NAME=
CRM_INQUIRY_EN_ORDER_SHOP_CLASSIFY=2

# —— 技术方案 / 出厂 / 平台报价 ——
CRM_INQUIRY_EN_TECH_PROGRAM=生产验证技术方案
# CRM_INQUIRY_EN_TECH_FILE_NAME=
# CRM_INQUIRY_EN_TECH_FILE_URL=
# CRM_INQUIRY_EN_FACTORY_CITY=
CRM_INQUIRY_EN_COMPARE_PRICE_REMARK=生产验证比价小结
CRM_INQUIRY_EN_PLATFORM_UNIT_PRICE=10
CRM_INQUIRY_EN_PLATFORM_PRICE_TYPE=含税不含运
CRM_INQUIRY_EN_PLATFORM_DESC=生产验证平台报价备注

# 安全：默认禁止造数；上线当晚 create 仍须加 --allow-prod-seed
CRM_INQUIRY_ALLOW_PROD_SEED=0
