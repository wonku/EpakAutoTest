# 询价单（录制 20260804-105954 / inquiry_main）
# CRM_INQUIRY_CUSTOMER_ID=1036
# CRM_INQUIRY_BUYER_MEMBER_ID=104450
# CRM_INQUIRY_BUYER_MEMBER_NAME=北京郑州企业商会
# CRM_INQUIRY_BUYER_USER_ID=104632
# CRM_INQUIRY_BUYER_SALE_ORG_TYPE=5
# CRM_INQUIRY_CATEGORY_FULL_ID=00100803.00100804.00100805.00100806
# CRM_UI_INQUIRY_CUSTOMER_KEYWORD=北京郑州企业商会
# 按状态造数（pytest -m inquiry_seed 或 python scripts/create_inquiry.py --status 待提交技术方案）
# CRM_INQUIRY_TARGET_STATUS=待提交技术方案
# CRM_INQUIRY_SEED_STATUSES=新建草稿,待提交技术方案
# 创建入口：crm_customer | internal（交易能力/内部询价单）
# CRM_INQUIRY_CREATE_SOURCE=internal
# 商城：cn 中文商城 | en 英文商城
# CRM_INQUIRY_MALL=cn
# 询价单语种：cn 中文询价单 | en 英文询价单（中文商城可建英文单，对应 mallType=2）
# CRM_INQUIRY_FORM=cn
# 子单类型：定制品(2) | 通用品(1)；流转按子单类型
# CRM_INQUIRY_ASK_PRICE_TYPE=定制品
# 一笔主单多子单（优先于 ASK_PRICE_TYPE）：
# CRM_INQUIRY_SUBS_JSON=[{"ask_price_type":"定制品"},{"ask_price_type":"通用品","target_status":"待出厂报价"}]
# 英文询价买家（中文商城建英文单 / 英文商城）
# CRM_INQUIRY_EN_BUYER_MEMBER_ID=569
# CRM_INQUIRY_EN_BUYER_MEMBER_NAME=CURSOR注册客户8650
# CRM_INQUIRY_EN_BUYER_USER_ID=101926
# CRM_INQUIRY_EN_CATEGORY_FULL_ID=00100101.00100102.00100252.00100253
# CRM_INQUIRY_TX_SUBMIT_API_URL=https://test-platform.ysbpack.com/api/transaction/iqrMain/submitOrUpdate
#
# ========== 询价造数：中英文按环境拆分（互不覆盖） ==========
# 同一 --env 会依次加载:
#   .env → .env.en.{env} → .env.cn.{env}
# 英文站文件（EPAK_* / CRM_INQUIRY_EN_*）:
#   .env.en.test / .env.en.uat / .env.en.prod
#   模板: .env.en.test.example | .env.en.uat.example | .env.en.prod.example
# 中文站文件（PLATFORM_* / LOGIN_* / CRM_INQUIRY_BUYER_*）:
#   .env.cn.test / .env.cn.uat / .env.cn.prod
#   模板: .env.cn.test.example
# 调用:
#   python scripts/create_inquiry.py --env test --source internal --mall en --form en ...
#   python scripts/create_inquiry.py --env test --source internal --mall cn --form cn --type 通用品 --status 待出厂报价
#   python scripts/create_inquiry.py --env uat  --source internal --mall en --form en ...
#   生产上线前预检（域名/接口可达/登录/只读，不创建）:
#   python scripts/verify_prod_inquiry_env.py --env prod --operate-via both
#   生产上线全套造数:
#   python scripts/create_inquiry.py --env prod --allow-prod-seed --source internal --mall en --form en --status 已完成
# 查看当前环境（含 en/cn profile 是否存在）:
#   python scripts/create_inquiry.py --env test --list-env
#
# 中文角色账号请写在 .env.cn.*；密码不填则复用 LOGIN_PASSWORD_ENCRYPTED
# CRM_INQUIRY_TECH_ACCOUNT=
# CRM_INQUIRY_TECH_PASSWORD_ENCRYPTED=
# CRM_INQUIRY_PURCHASER_ACCOUNT=
# CRM_INQUIRY_PURCHASER_PASSWORD_ENCRYPTED=
# CRM_INQUIRY_SUPPORT_ACCOUNT=
# CRM_INQUIRY_SUPPORT_PASSWORD_ENCRYPTED=

