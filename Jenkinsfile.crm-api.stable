// CRM API 回归（线索 + 客户 + 异常场景等 @api）— 网络不稳定时推荐：Pipeline script（粘贴到 Jenkins，不要用 Pipeline script from SCM）
// 直接使用本机已有代码目录（如 E:\cursor\Pyautotest），GitHub 不通时勾选 SKIP_GIT_SYNC。
// 客户用例：tests/test_api_customer_flow.py（page / findById / checkRepeat / activity）
// 销售机会：tests/test_api_opportunity_flow.py（page / findById / activity / contactPerson）
//
// Job 配置：
//   Definition = Pipeline script
//   将本文件内容粘贴到 Script 框
//   确认 environment.REPO_DIR 指向本机代码路径
pipeline {
    agent any

    triggers {
        cron('H 3 * * *')
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '15'))
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'SKIP_GIT_SYNC',
            defaultValue: true,
            description: '跳过 git pull，直接使用 REPO_DIR 已有代码（GitHub 不通时建议勾选）'
        )
        booleanParam(
            name: 'SEND_EMAIL_REPORT',
            defaultValue: true,
            description: '执行结束后发送邮件'
        )
        booleanParam(
            name: 'INCLUDE_NEGATIVE',
            defaultValue: true,
            description: '是否包含 tests/test_api_negative.py 异常场景用例（客户/线索主路径始终包含）'
        )
        string(
            name: 'GIT_UPDATE_MAX_ATTEMPTS',
            defaultValue: '5',
            description: 'git 更新失败时的最大重试次数（SKIP_GIT_SYNC 未勾选时生效）'
        )
        string(
            name: 'GIT_UPDATE_WAIT_SECONDS',
            defaultValue: '90',
            description: 'git 重试间隔（秒）'
        )
    }

    environment {
        REPO_DIR = 'E:\\cursor\\Pyautotest'
        GIT_BRANCH = 'main'
        LOGIN_PHONE = credentials('LOGIN_PHONE')
        LOGIN_PASSWORD_ENCRYPTED = credentials('LOGIN_PASSWORD_ENCRYPTED')
        EMAIL_SMTP_HOST = credentials('EMAIL_SMTP_HOST')
        EMAIL_FROM = credentials('EMAIL_FROM')
        EMAIL_USERNAME = credentials('EMAIL_USERNAME')
        EMAIL_TO = credentials('EMAIL_TO')
        EMAIL_PASSWORD = credentials('EMAIL_PASSWORD')
        PYTHONIOENCODING = 'utf-8'
        PYTHONUTF8 = '1'
    }

    stages {
        stage('Sync repo (retry)') {
            when {
                expression { return !params.SKIP_GIT_SYNC }
            }
            steps {
                dir("${env.REPO_DIR}") {
                    bat """
                        set GIT_UPDATE_MAX_ATTEMPTS=${params.GIT_UPDATE_MAX_ATTEMPTS}
                        set GIT_UPDATE_WAIT_SECONDS=${params.GIT_UPDATE_WAIT_SECONDS}
                        set GIT_BRANCH=${env.GIT_BRANCH}
                        scripts\\jenkins_git_update_retry.bat
                    """
                }
            }
        }

        stage('Install Python deps') {
            steps {
                dir("${env.REPO_DIR}") {
                    retry(2) {
                        bat 'python -m pip install -r requirements.txt'
                    }
                }
            }
        }

        stage('CRM API regression') {
            steps {
                dir("${env.REPO_DIR}") {
                    script {
                        def emailFlag = params.SEND_EMAIL_REPORT ? 'true' : 'false'
                        def includeNegative = params.INCLUDE_NEGATIVE ? 'true' : 'false'
                        bat """
                            chcp 65001 >nul
                            set SEND_EMAIL_REPORT=${emailFlag}
                            set INCLUDE_NEGATIVE=${includeNegative}
                            scripts\\run_crm_api_jenkins.bat
                            if errorlevel 1 exit /b 1
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            dir("${env.REPO_DIR}") {
                archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
                junit allowEmptyResults: true, testResults: 'reports/junit/crm-api.xml'
            }
        }
        success {
            echo 'CRM API 回归通过（含客户 page/详情/查重/活动），报告已归档至 Build Artifacts'
        }
        failure {
            echo 'CRM API 回归失败，请查看 Console、reports/junit/crm-api.xml 与 Allure 结果'
        }
    }
}
